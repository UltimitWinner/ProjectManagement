# Copy this file to .dev.vars and replace each value before running locally.
# Use a unique random secret (at least 32 characters) for APP_PEPPER.
APP_PEPPER=replace-with-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_USERNAME=choose-your-admin-username
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOOTSTRAP_NAME=Local Administrator

# Optional comma-separated exact hostnames/wildcards for custom Canvas domains (e.g. canvas.school.org,*.district.net).
CANVAS_ALLOWED_HOSTS=
